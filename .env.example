ENV=development
REACT_FRONTEND_ENABLED=1
APP_BASE_URL=
SITE_URL=
DATABASE_URL=
SESSION_SECRET=
JOB_SECRET=
LOG_LEVEL=INFO
SLOW_REQUEST_MS=1000
DB_POOL_SIZE=3
DB_MAX_OVERFLOW=2
DB_POOL_TIMEOUT=10
DB_POOL_RECYCLE=1800
EXPORT_SYNC_MAX_ROWS=5000
# Search/source caches are per-instance. Redis is not required or enabled in this release.
SOURCE_TIMEOUT_SECONDS=30
SOURCE_MAX_RETRIES=3
SOURCE_REQUESTS_PER_SECOND=1.5
SOURCE_CIRCUIT_FAILURE_THRESHOLD=5
SOURCE_CIRCUIT_COOLDOWN_SECONDS=60
SEARCH_CACHE_TTL_SECONDS=120
TENDER_CACHE_TTL_SECONDS=1800
RESULT_CACHE_TTL_SECONDS=900
DOCUMENT_CACHE_TTL_SECONDS=1800
SYNC_BATCH_SIZE=10
SYNC_MAX_CONCURRENCY=2
TENDER_STALE_AFTER_SECONDS=21600
SYNC_COMPLETED_RETENTION_DAYS=14
SYNC_FAILED_RETENTION_DAYS=45
AI_ENABLED=false
AI_PROVIDER=
OPENAI_API_KEY=
AI_MODEL=
MAX_UPLOAD_MB=10
MAX_USER_UPLOAD_MB=10
MAX_DOCUMENT_DOWNLOAD_MB=25
DOCUMENT_CACHE_DAYS=30
DATA_QUALITY_ENABLED=true
DATA_QUALITY_BATCH_SIZE=100
STALE_TENDER_DAYS=14
STALE_DOCUMENT_DAYS=30
DUPLICATE_CONFIDENCE_THRESHOLD=0.85
OUTLIER_DETECTION_ENABLED=false
INLINE_EXTRACTION_MAX_MB=3
STORAGE_BACKEND=local
GCS_BUCKET=
AI_REQUESTS_PER_MINUTE=10
# Chỉ đặt khi bạn có đơn giá thực, cùng đơn vị tiền tệ cho cả hai.
AI_INPUT_PRICE_PER_1M=
AI_OUTPUT_PRICE_PER_1M=
